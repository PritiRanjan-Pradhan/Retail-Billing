<UserControl x:Class="RetailPOS.WPF.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Customer:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding AvailableCustomers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name" Width="200" />
        </StackPanel>

        <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,8,0">
            <TextBlock Text="Products" FontWeight="Bold" />
            <DataGrid ItemsSource="{Binding AvailableProducts}" SelectedItem="{Binding SelectedProduct}" AutoGenerateColumns="False" Height="220">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                    <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" />
                    <DataGridTextColumn Header="Price" Binding="{Binding Price}" />
                    <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity}" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Qty:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                <Button Content="Add to Cart" Command="{Binding AddToCartCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="2">
            <TextBlock Text="Cart" FontWeight="Bold" />
            <DataGrid ItemsSource="{Binding CartItems}" SelectedItem="{Binding SelectedCartItem}" AutoGenerateColumns="False" Height="300">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" />
                    <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" />
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" />
                    <DataGridTextColumn Header="Unit" Binding="{Binding UnitPrice}" />
                    <DataGridTextColumn Header="Total" Binding="{Binding LineTotal}" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Remove" Command="{Binding RemoveFromCartCommand}" Width="90" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock Text="Total:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="{Binding Total}" Width="80" />
            <Button Content="Save Sale" Command="{Binding SaveSaleCommand}" Width="90" Margin="8,0,0,0" />
            <Button Content="Print Receipt" Command="{Binding PrintReceiptCommand}" Width="110" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
