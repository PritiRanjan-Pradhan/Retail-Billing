<Window x:Class="RetailPOS.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RetailPOS.WPF"
        xmlns:views="clr-namespace:RetailPOS.WPF.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Margin="8" />

        <TabControl Grid.Row="1" Margin="8">
            <TabItem Header="Products">
                <views:ProductsView DataContext="{Binding ProductsViewModel}" />
            </TabItem>
            <TabItem Header="Customers">
                <views:CustomersView DataContext="{Binding CustomersViewModel}" />
            </TabItem>
            <TabItem Header="Sales">
                <views:SalesView DataContext="{Binding SalesViewModel}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
